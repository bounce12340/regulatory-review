{
  "name": "regulatory-review-cloudflare",
  "version": "4.0.0",
  "private": true,
  "description": "RegReview — TFDA regulatory review platform on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && wrangler d1 migrations apply regulatory-review --remote",
    "db:migrate:local": "wrangler d1 migrations apply regulatory-review --local",
    "db:migrate:remote": "wrangler d1 migrations apply regulatory-review --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "test:e2e": "node test/e2e-api.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0",
    "yaml": "^2.9.1"
  }
}
